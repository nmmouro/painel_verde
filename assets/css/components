.card{
  background:var(--card);
  border-radius:16px;
  border:1px solid rgba(255,255,255,.08);
  overflow:auto;
}

.card h2{
  text-align:center;
  padding:10px;
  font-size:18px;
}

/* BOTÕES */
button{
  border:none;
  border-radius:10px;
  padding:8px 14px;
  font-weight:700;
  cursor:pointer;
  transition:.2s;
}

button:hover{
  transform:scale(1.05);
}

/* TABELA */
table{
  width:100%;
  border-collapse:collapse;
}

thead th{
  position:sticky;
  top:0;
  background:var(--header);
  padding:10px;
}

tbody td{
  padding:10px;
  background:var(--table);
  text-align:center;
}

tbody tr:nth-child(even) td{
  background:var(--table-alt);
}
