export function filtrarAgendaHoje(rows) {

  const hoje = new Date();

  const dataHoje =
    `${String(hoje.getDate()).padStart(2,"0")}/` +
    `${String(hoje.getMonth()+1).padStart(2,"0")}/` +
    `${hoje.getFullYear()}`;

  return rows.filter(row => {

    const v =
      (row.c || []).map(getCell);

    return String(v[0] || "").trim() === dataHoje;
  });

}

export function ordenarAgenda(rows){

  return rows.sort((a,b)=>{

    const va =
      (a.c || []).map(getCell);

    const vb =
      (b.c || []).map(getCell);

    return new Date(
      `${va[0]} ${va[1]}`
    ) - new Date(
      `${vb[0]} ${vb[1]}`
    );

  });

}
